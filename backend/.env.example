GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Small FastEmbed English model; Arabic passages and queries are translated for retrieval.
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: defaults to the Arabic traffic PDF in the project root.
# TRAFFIC_LAW_PDF=../your-traffic-law.pdf
PORT=5000


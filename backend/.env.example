GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# FastEmbed-supported multilingual CPU model used for Arabic/English retrieval.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional: defaults to the Arabic traffic PDF in the project root.
# TRAFFIC_LAW_PDF=../your-traffic-law.pdf
PORT=5000

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Local CPU multilingual embeddings used to search the Arabic/English PDF.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional: defaults to the Arabic traffic PDF in the project root.
# TRAFFIC_LAW_PDF=../your-traffic-law.pdf
PORT=5000
